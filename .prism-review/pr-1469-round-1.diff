+package cmd
+
+// Tests for --json flag on prism list-sessions (#1463).
+//
+// Both the direct-DB path and the proxy path are exercised.
+
+import (
+	"encoding/json"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/prismatic-koi/prism/internal/db"
