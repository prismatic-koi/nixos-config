{
  // Project-level overrides for this nixos-config repo.
  //
  // Branch protection is enabled on main, so direct pushes are safe to auto-allow —
  // the remote will reject anything that hasn't gone through a PR. This reduces
  // friction for the worker agent when landing work.
  "$schema": "https://opencode.ai/config.json",
  // Agent-scoped permissions are merged with the global config and take precedence
  // (per opencode docs: "Agent permissions are merged with the global config, and
  // agent rules take precedence"). Overriding within `agent.worker` is therefore
  // sufficient to shadow the global `permission.bash` entries that set push to "ask".
  //
  // Note: default_agent is intentionally absent here. Container sessions have
  // OPENCODE_CONFIG_CONTENT injected with the correct default_agent (worker or
  // coordinator) at precedence level 6, which beats any project-level config.
  // Interactive host sessions use whatever agent the user selects.
  "agent": {
    "worker": {
      "permission": {
        "bash": {
          // Allow git push without prompting — branch protection on main acts as the
          // safety net, so there is no risk of accidentally force-pushing to main.
          "git push": "allow",
          "git push *": "allow",
          "git -C * push": "allow",
          "git -C * push *": "allow",
          "git --git-dir* push": "allow",
          "git --git-dir* push *": "allow",
          // Low-level push equivalents (git send-pack / git receive-pack)
          "git send-pack": "allow",
          "git send-pack *": "allow",
          "git receive-pack *": "allow",

          // Allow opening PRs — branch protection requires review before merging,
          // so auto-allowing pr create is low-risk and keeps the workflow smooth.
          "gh pr create": "allow",
          "gh pr create *": "allow"
        }
      }
    }
  }
}
