{
  "description": "Values of PRISM_CREDENTIAL_FILES and the registry that both redactors must parse from each: internal/payload ParseCredentialFiles and prism.ts parseCredentialFiles. want maps each path variable to its marker name.",
  "cases": [
    { "name": "empty value", "value": "", "want": {} },
    { "name": "one entry", "value": "A_FILE=A", "want": { "A_FILE": "A" } },
    {
      "name": "two entries",
      "value": "A_PASSWORD_FILE=A_PASSWORD,B_TOKEN_FILE=B_TOKEN",
      "want": { "A_PASSWORD_FILE": "A_PASSWORD", "B_TOKEN_FILE": "B_TOKEN" }
    },
    { "name": "digits and underscores", "value": "A1_B2_FILE=A1_B2", "want": { "A1_B2_FILE": "A1_B2" } },
    { "name": "the first entry for a name wins", "value": "A_FILE=A,A_FILE=B", "want": { "A_FILE": "A" } },
    { "name": "an entry with no equals sign is skipped", "value": "A_FILE,B_FILE=B", "want": { "B_FILE": "B" } },
    { "name": "a second equals sign is part of the marker", "value": "A_FILE=A=B,B_FILE=B", "want": { "B_FILE": "B" } },
    { "name": "an empty name is skipped", "value": "=A,B_FILE=B", "want": { "B_FILE": "B" } },
    { "name": "an empty marker is skipped", "value": "A_FILE=,B_FILE=B", "want": { "B_FILE": "B" } },
    { "name": "a lower-case name is skipped", "value": "a_file=A,B_FILE=B", "want": { "B_FILE": "B" } },
    { "name": "a lower-case marker is skipped", "value": "A_FILE=a,B_FILE=B", "want": { "B_FILE": "B" } },
    { "name": "a leading digit is skipped", "value": "1_FILE=A,B_FILE=1B", "want": {} },
    { "name": "a leading underscore is skipped", "value": "_A_FILE=A,B_FILE=_B", "want": {} },
    { "name": "a space around an entry is skipped", "value": " A_FILE=A,B_FILE=B ,C_FILE=C", "want": { "C_FILE": "C" } },
    { "name": "a trailing newline is skipped", "value": "A_FILE=A,B_FILE=B\n", "want": { "A_FILE": "A" } },
    { "name": "empty entries are skipped", "value": ",,A_FILE=A,,", "want": { "A_FILE": "A" } },
    { "name": "a path in the marker is skipped", "value": "A_FILE=../A,B_FILE=B/C", "want": {} },
    { "name": "a non-ASCII letter is skipped", "value": "\u00c0_FILE=A,B_FILE=\u00c0", "want": {} },
    { "name": "a semicolon is not a separator", "value": "A_FILE=A;B_FILE=B", "want": {} }
  ]
}
